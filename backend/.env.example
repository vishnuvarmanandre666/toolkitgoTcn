# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (frontend)
CORS_ORIGINS=http://localhost:3000
# Set true behind HTTPS so auth cookies get the Secure flag
COOKIE_SECURE=false

# -------------------------------------------------------------- database ----
DATABASE_URL=mysql://toolkitgo:toolkitgo@localhost:3307/toolkitgo

# ----------------------------------------------------------------- redis ----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redispass

# ------------------------------------------------------------------- OTP ----
# Long random secret (>= 32 chars). Used for HMAC-SHA256 of OTPs.
OTP_SECRET=change-me-to-a-long-random-otp-secret-value
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_WINDOW_SECONDS=900
# How long a number stays blocked after OTP_MAX_ATTEMPTS failures
OTP_LOCK_SECONDS=900
# Per-IP cap on OTP sends per hour (abuse protection)
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# ----------------------------------------------------------------- MSG91 ----
# SMS_DRIVER=msg91 in production. "console" logs OTPs (refused when NODE_ENV=production).
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
# Name of the OTP variable in your MSG91 Flow template (e.g. "otp" or "VAR1")
MSG91_OTP_VARIABLE=otp

# ------------------------------------------------------------------ auth ----
JWT_SECRET=change-me-to-a-long-random-jwt-secret-value
TECHNICIAN_SESSION_HOURS=72
ADMIN_SESSION_HOURS=12

# Initial super admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@toolkitgo.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=ToolkitGo Admin

# ------------------------------------------------------------ encryption ----
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Separate secret for blind-index HMACs (duplicate detection)
BLIND_INDEX_SECRET=change-me-to-another-long-random-secret

# ----------------------------------------------------------- KYC policy ----
REQUIRE_BANK_DETAILS=true
REQUIRE_BANK_PROOF=false
REQUIRE_ADDRESS_PROOF=false
REQUIRE_CERTIFICATES=false
# Persist the full Aadhaar number (encrypted)? Default false: only last 4 + blind index.
# Only enable if your organisation is legally permitted (e.g. Aadhaar Data Vault in place).
AADHAAR_STORE_ENCRYPTED=false
# Version string of the consent text shown to technicians
AADHAAR_CONSENT_VERSION=2026-11-v1
# Name-match threshold (0..1) for provider results
NAME_MATCH_THRESHOLD=0.8

# --------------------------------------------- identity verification ----
# manual  -> every submission goes to authorised manual review (safe default)
# mock    -> deterministic sandbox for local testing (refused in production)
AADHAAR_PROVIDER=manual
PAN_PROVIDER=manual

# -------------------------------------------------------------- storage ----
# s3 (any S3-compatible private bucket, e.g. AWS S3 / SeaweedFS) or local (private dir, dev only)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=ap-south-1
S3_BUCKET=toolkitgo-kyc
S3_ACCESS_KEY_ID=toolkitgo-dev-key
S3_SECRET_ACCESS_KEY=toolkitgo-dev-secret-123
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./storage
# Public base URL of this API, used for local-driver signed URLs
API_PUBLIC_URL=http://localhost:4000
SIGNED_URL_TTL_SECONDS=120

# --------------------------------------------------------------- uploads ----
MAX_UPLOAD_MB=5
# Optional ClamAV daemon for malware scanning; leave blank to skip (status SKIPPED)
CLAMAV_HOST=
CLAMAV_PORT=3310
# Superseded / rejected document versions are purged after this many days
DOCUMENT_VERSION_RETENTION_DAYS=180

# ------------------------------------------------- Supabase phone login ----
# Optional. When set, POST /api/auth/supabase/session exchanges a Supabase Auth
# phone-OTP session for a ToolkitGo technician session. Same URL + anon key as the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------ DigiLocker ----
# Aadhaar (e-Aadhaar) + PAN fetched with the technician's consent from DigiLocker.
#   off  -> disabled
#   mock -> local sandbox that simulates DigiLocker (development only; refused in production)
#   live -> real DigiLocker Requester API (needs partner credentials from DigiLocker / API Setu)
DIGILOCKER_MODE=off
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# Must EXACTLY match the redirect URI registered in the DigiLocker partner portal.
# The frontend proxies /api to this backend, so use your public site URL:
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/kyc/digilocker/callback
# Use the host DigiLocker assigns to your client (e.g. https://api.digitallocker.gov.in
# or https://digilocker.meripehchaan.gov.in for the newer Meri Pehchaan endpoints).
DIGILOCKER_AUTH_BASE_URL=https://api.digitallocker.gov.in
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in
