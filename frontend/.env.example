# Where the Next.js server proxies /api/* (server-side only)
BACKEND_URL=http://localhost:4000
# Shown in upload hints; keep in sync with backend MAX_UPLOAD_MB
NEXT_PUBLIC_MAX_UPLOAD_MB=5

# --- Supabase phone login (optional) ---------------------------------------
# When both are set, technicians log in with Supabase Auth phone OTP instead of
# ToolkitGo's own OTP API. Use the project URL and the anon / publishable key
# (Project Settings -> API). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep equal to Auth -> Providers -> Phone -> "SMS OTP Expiry" in Supabase
NEXT_PUBLIC_SUPABASE_OTP_EXPIRY_SECONDS=300
NEXT_PUBLIC_SUPABASE_RESEND_SECONDS=60
